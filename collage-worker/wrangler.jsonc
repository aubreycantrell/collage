/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
 {
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "collage-worker",
	"main": "src/index.js",
	"r2_buckets": [
		{
			"bucket_name": "collage-collaborator",
			"binding": "collage_sessions"
		}
	],
	"vars": {
		"R2_PUBLIC_URL": "https://pub-01813beedf7e4147ab19e8e6215e2622.r2.dev"
	},
	"compatibility_date": "2025-10-04",
	"observability": {
		"enabled": true
	}
}